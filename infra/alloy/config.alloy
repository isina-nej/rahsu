discovery.docker "services" {
  host = "unix:///var/run/docker.sock"
}
discovery.relabel "services" {
  targets = discovery.docker.services.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
  }
}
loki.source.docker "containers" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.services.output
  forward_to = [loki.write.default.receiver]
}
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "rahsu" {
  http { endpoint = "0.0.0.0:4318" }
  output { traces = [otelcol.exporter.otlphttp.tempo.input] }
}
otelcol.exporter.otlphttp "tempo" {
  client { endpoint = "http://tempo:4318" }
}
