{
  "uid": "rahsu-ops", "title":"Rahsu - API Health",
  "tags":["rahsu","observability"],"timezone":"browser",
  "schemaVersion":39,"version":1,"refresh":"30s",
  "time":{"from":"now-6h","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"API up","gridPos":{"h":6,"w":6,"x":0,"y":0},
     "datasource":{"type":"prometheus","uid":"prometheus"},
     "targets":[{"expr":"up{job=\"api-health\"}","refId":"A"}]},
    {"id":2,"type":"stat","title":"Requests per second","gridPos":{"h":6,"w":6,"x":6,"y":0},
     "datasource":{"type":"prometheus","uid":"prometheus"},
     "targets":[{"expr":"sum(rate(rahsu_http_requests_total[5m]))","refId":"A"}]},
    {"id":3,"type":"stat","title":"HTTP 5xx per second","gridPos":{"h":6,"w":6,"x":12,"y":0},
     "datasource":{"type":"prometheus","uid":"prometheus"},
     "targets":[{"expr":"sum(rate(rahsu_http_requests_total{status=~\"5..\"}[5m]))","refId":"A"}]},
    {"id":4,"type":"stat","title":"P95 latency seconds","gridPos":{"h":6,"w":6,"x":18,"y":0},
     "datasource":{"type":"prometheus","uid":"prometheus"},
     "targets":[{"expr":"histogram_quantile(0.95,sum(rate(rahsu_http_duration_seconds_bucket[5m])) by (le))","refId":"A"}]},
    {"id":5,"type":"timeseries","title":"HTTP requests by status","gridPos":{"h":9,"w":24,"x":0,"y":6},
     "datasource":{"type":"prometheus","uid":"prometheus"},
     "targets":[{"expr":"sum by (status)(rate(rahsu_http_requests_total[5m]))","refId":"A"}]}
  ]
}