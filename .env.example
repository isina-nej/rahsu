# Copy to .env. Never commit real secrets.
DJANGO_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_VALUE
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ORIGINS=http://localhost:5173
POSTGRES_DB=rahsu
POSTGRES_USER=rahsu
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# Keep the router image identical while preparing and serving OSRM graph files.
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v26.10.0-debian@sha256:55dbfd47d984c2cacd64e32901b4321c86b5ec761438e69aa053dc78698a786f
OSRM_BASE_URL=http://osrm:5000
FUEL_DEFAULT_VARIANT=pride-131
TEHRAN_BBOX=51.05,35.45,51.75,35.95
# API token is required to view logs remotely; generate with secrets.token_urlsafe(40)
OPS_READ_TOKEN=
LOKI_BASE_URL=http://loki:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
OTEL_TRACING_ENABLED=0

# Optional self-hosted OpenTopoData endpoint. Leave empty until provisioned.
ELEVATION_BASE_URL=

# Self-hosted Nominatim-compatible geocoder URL; no live autocomplete.
GEOCODER_BASE_URL=

PROMETHEUS_BASE_URL=http://prometheus:9090
TEMPO_BASE_URL=http://tempo:3200

# Registration is closed by default; create accounts via Django admin.
ALLOW_PUBLIC_SIGNUP=0

# Add the production HTTPS origin when deployed (e.g. https://fuel.example.org)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
TRUST_REVERSE_PROXY=0
